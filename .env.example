# Optional override for the win-screen feedback endpoint.
#
# Not required: the deployed Google Apps Script web app URL is baked into
# DEFAULT_FEEDBACK_ENDPOINT in src/lib/feedback.ts, so feedback works on every
# build (Vercel, local, preview) without any env var. Set this only to point at
# a different script.
#
# The script should expect a POST of JSON:
# { name, email, feedback, device, total_time_sec, escape_sec,
#   completed_at_iso, submitted_at_iso } and write it to a spreadsheet row.
VITE_FEEDBACK_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
